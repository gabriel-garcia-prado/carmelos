# Local (non-Docker) dev config for the API. Bun auto-loads this file.
# POSTGRES_PASSWORD must match the one in the root .env that starts Postgres.
POSTGRES_PASSWORD='my_password'
BETTER_AUTH_SECRET='random_string'
BETTER_AUTH_URL='http://localhost:3000'
TRUSTED_ORIGINS='http://localhost:5173'

# Optional: a full URL here overrides the assembled one (managed/hosted DB).
# DATABASE_CONNECTION_STRING='postgresql://user:pass@host:5432/db'

# Optional: needed only for the drive-time auto-calculation (Settings ->
# Shop / kitchen address, and the "Calculate" buttons on the event form).
# Create one at https://console.cloud.google.com/google/maps-apis/credentials
# with the Distance Matrix API enabled and billing turned on, then restrict
# the key to that API.
# GOOGLE_MAPS_API_KEY='your_key_here'

# Dev only: serve stand-in forecasts so the weather badges work without
# a Geocoding-enabled key. Never set this in production.
# MOCK_WEATHER='true'
